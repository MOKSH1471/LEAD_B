# Search Provider: 'osm' (100% Free / No API Key or Credit Card needed) or 'google'
SEARCH_PROVIDER=osm

# Telegram Bot Token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# Gemini API Key (from https://aistudio.google.com/ - 100% Free)
GEMINI_API_KEY=

# Gmail SMTP Settings (App Password from Google Account Security)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Sender Name
FROM_NAME=Your Name

# Default Prospecting Parameters
NICHE=dentists
REGION=Austin, TX
MAX_RESULTS=10

# Mode
DRY_RUN=false
EMAIL_DELAY_MS=15000

# Automated Follow-Up Settings
FOLLOWUP_DELAY_DAYS=3
FOLLOWUP_FINAL_DELAY_DAYS=4
MAX_FOLLOWUPS=2

# Autopilot Autonomous Prospecting & Follow-Up
AUTOPILOT_ENABLED=false
AUTOPILOT_INTERVAL_HOURS=12
AUTOPILOT_BATCH_SIZE=5
AUTOPILOT_NICHES=dentists, gyms, plumbers, roofing, chiropractors
AUTOPILOT_REGIONS=Austin, TX; Miami, FL; Chicago, IL; Dallas, TX; Phoenix, AZ
