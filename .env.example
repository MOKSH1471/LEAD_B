# Search Provider: 'osm' (100% Free / No API Key or Credit Card needed) or 'google'
SEARCH_PROVIDER=osm

# Telegram Bot Token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# Gemini API Key (from https://aistudio.google.com/ - 100% Free)
GEMINI_API_KEY=

# ==============================================================================
# SINGLE EMAIL ACCOUNT SETTINGS (Titan Email / GoDaddy / Custom Domain / Gmail)
# ==============================================================================
# If using Titan from GoDaddy:
EMAIL_USER=you@yourdomain.com
EMAIL_PASS=your_titan_password
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
IMAP_HOST=imap.titan.email
IMAP_PORT=993
IMAP_SECURE=true

# Sender Name in the email headers
FROM_NAME=Your Name

# ==============================================================================
# PROSPECTING & CAMPAIGN PARAMETERS
# ==============================================================================
NICHE=dentists
REGION=Austin, TX
MAX_RESULTS=50

# Mode (false = send real emails; true = preview in console only)
DRY_RUN=false
# Delay between each email sent in milliseconds (15000 = 15s delay to protect domain)
EMAIL_DELAY_MS=15000

# Automated Follow-Up Settings
FOLLOWUP_DELAY_DAYS=3
FOLLOWUP_FINAL_DELAY_DAYS=4
MAX_FOLLOWUPS=2

# Autopilot Autonomous Prospecting & Follow-Up (optional)
AUTOPILOT_ENABLED=false
AUTOPILOT_INTERVAL_HOURS=12
AUTOPILOT_BATCH_SIZE=5
AUTOPILOT_NICHES=dentists, gyms, plumbers, roofing, chiropractors
AUTOPILOT_REGIONS=Austin, TX; Miami, FL; Chicago, IL; Dallas, TX; Phoenix, AZ
