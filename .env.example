# Search Provider: 'osm' (100% Free / No API Key or Credit Card needed) or 'google'
SEARCH_PROVIDER=osm

# Telegram Bot Token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# Gemini API Key (from https://aistudio.google.com/ - 100% Free)
GEMINI_API_KEY=

# Resend API Key (from https://resend.com/ - 100% Free, 3000 emails/mo, works on Render cloud)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Gmail SMTP Settings (Fallback when running on local laptop)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Sender Name
FROM_NAME=Your Name

# Default Prospecting Parameters
NICHE=dentists
REGION=Austin, TX
MAX_RESULTS=10

# Mode
DRY_RUN=false
EMAIL_DELAY_MS=15000
